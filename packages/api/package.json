    "better-auth": "^1.7.7",
    "cors": "^2.8.6",
    "cross-env": "^10.1.0",
    "dotenv": "^18.0.5",
    "express": "^5.2.1",
    "helmet": "^8.3.0",
    "morgan": "^1.12.1",
    "supertest": "^7.3.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/helmet": "^4.0.0",
    "@types/morgan": "^1.9.10",
    "@types/node": "^26.6.4",
    "tsx": "^4.23.15",
